{
  "name": "second-opinion",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Verified, locality-level price layer for the informal economy. Appwrite TablesDB hackathon build.",
  "scripts": {
    "test": "node --test core/core.test.js",
    "sync:core": "node scripts/sync-core.mjs",
    "seed": "node scripts/with-key.mjs tsx seed/seed.ts",
    "seed:dry": "tsx seed/seed.ts --dry-run",
    "stats": "node scripts/with-key.mjs node scripts/recompute.mjs",
    "deploy:functions": "npm run sync:core && appwrite push functions --all --force && npm run prune",
    "deploy:web": "npm run sync:core && appwrite push sites --all --force && npm run prune",
    "test:e2e": "node scripts/with-key.mjs npx tsx scripts/e2e-backend.ts",
    "warm": "node scripts/warm.mjs",
    "test:ui": "node scripts/with-key.mjs npx tsx scripts/e2e-ui.ts",
    "a11y": "node scripts/a11y.mjs",
    "perf": "node scripts/perf.mjs",
    "shots": "node scripts/shots.mjs",
    "prune": "node scripts/prune-deployments.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "axe-core": "^4.14.0",
    "node-appwrite": "^31.0.0",
    "puppeteer-core": "^24.43.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
